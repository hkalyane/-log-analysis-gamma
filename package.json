{
  "name": "log-analysis-gamma",
  "displayName": "Log Analysis Gamma",
  "description": "Advanced log analysis with colorful filters, focus mode, and enhanced features. New in v1.5.0: Revolutionary selective editor processing for 50-90% performance improvement. Smart editor selection strategies (active/visible/relevant/adaptive) with configurable max editors. Complete color management with random generator, memory system, and individual removal. Features major performance optimizations and VS Code 1.85.1 compatibility.",
  "publisher": "hkalyane",
  "repository": {
    "type": "git",
    "url": "https://github.com/hkalyane/log-analysis-gamma.git"
  },
  "icon": "image/icon.png",
  "version": "1.5.0",
  "engines": {
    "vscode": "^1.49.0"
  },
  "categories": [
    "Other",
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "log",
    "analysis",
    "filter",
    "highlight",
    "focus",
    "regex",
    "debugging",
    "log viewer",
    "color picker",
    "gamma"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:focus-gamma"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "log-analysis-gamma.addGroup",
        "title": "Add Group",
        "icon": "$(file-directory-create)"
      },
      {
        "command": "log-analysis-gamma.editGroup",
        "title": "Edit a new name for This Group",
        "icon": "$(edit)"
      },
      {
        "command": "log-analysis-gamma.deleteGroup",
        "title": "Delete This Group",
        "icon": "$(dialog-close)"
      },
      {
        "command": "log-analysis-gamma.enableHighlight",
        "title": "Enable Highlight",
        "icon": "$(paintcan)"
      },
      {
        "command": "log-analysis-gamma.disableHighlight",
        "title": "Disable Highlight",
        "icon": "$(paintcan)"
      },
      {
        "command": "log-analysis-gamma.enableVisibility",
        "title": "Enable Visbility",
        "icon": "$(eye)"
      },
      {
        "command": "log-analysis-gamma.disableVisibility",
        "title": "Disable Visbility",
        "icon": "$(eye-closed)"
      },
      {
        "command": "log-analysis-gamma.turnOnFocusMode",
        "title": "Turn on Focus Mode",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "log-analysis-gamma.deleteFilter",
        "title": "Delete This Filter",
        "icon": "$(dialog-close)"
      },
      {
        "command": "log-analysis-gamma.editFilter",
        "title": "Edit Regex for This Filter",
        "icon": "$(edit)"
      },
      {
        "command": "log-analysis-gamma.changeFilterColor",
        "title": "Change Filter Color",
        "icon": "$(symbol-color)"
      },
      {
        "command": "log-analysis-gamma.addFilter",
        "title": "Add a Filter",
        "icon": "$(plus)"
      },
      {
        "command": "log-analysis-gamma.addExFilter",
        "title": "Add a Exclusion Filter",
        "icon": "$(plus)"
      },
      {
        "command": "log-analysis-gamma.deleteExGroup",
        "title": "Delete This Exclusion Group",
        "icon": "$(trash)"
      },
      {
        "command": "log-analysis-gamma.deleteProject",
        "title": "Delete This Project",
        "icon": "$(dialog-close)"
      },
      {
        "command": "log-analysis-gamma.editProject",
        "title": "Edit a new name for This Project",
        "icon": "$(edit)"
      },
      {
        "command": "log-analysis-gamma.addProject",
        "title": "Add Project",
        "icon": "$(repo-create)"
      },
      {
        "command": "log-analysis-gamma.openSettings",
        "title": "Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "log-analysis-gamma.refreshSettings",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "log-analysis-gamma.saveProject",
        "title": "Save groups to project",
        "icon": "$(save-as)"
      },
      {
        "command": "log-analysis-gamma.selectProject",
        "title": "Select project"
      },
      {
        "command": "log-analysis-gamma.openOriginalLocation",
        "title": "Open Original Location"
      },
      {
        "command": "log-analysis-gamma.clearColorMemory",
        "title": "Clear Recently Used Colors",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "log-analysis-gamma.addFilter",
          "when": "view == filters-gamma && viewItem =~ /^g-/",
          "group": "inline@1"
        },
        {
          "command": "log-analysis-gamma.editGroup",
          "when": "view == filters-gamma && viewItem =~ /^g-/",
          "group": "inline@2"
        },
        {
          "command": "log-analysis-gamma.editFilter",
          "when": "(view == filters-gamma || view == filters-gamma.minus) && viewItem =~ /^f-/",
          "group": "inline@2"
        },
        {
          "command": "log-analysis-gamma.changeFilterColor",
          "when": "view == filters-gamma && viewItem =~ /^f-/",
          "group": "inline@3"
        },
        {
          "command": "log-analysis-gamma.editProject",
          "when": "view == filters-gamma.settings",
          "group": "inline@3"
        },
        {
          "command": "log-analysis-gamma.disableHighlight",
          "when": "view == filters-gamma && viewItem =~ /-lit/",
          "group": "inline@4"
        },
        {
          "command": "log-analysis-gamma.enableHighlight",
          "when": "view == filters-gamma && viewItem =~ /-unlit/",
          "group": "inline@5"
        },
        {
          "command": "log-analysis-gamma.disableVisibility",
          "when": "(view == filters-gamma || view == filters-gamma.minus) && viewItem =~ /-visible/",
          "group": "inline@6"
        },
        {
          "command": "log-analysis-gamma.enableVisibility",
          "when": "(view == filters-gamma || view == filters-gamma.minus) && viewItem =~ /-invisible/",
          "group": "inline@6"
        },
        {
          "command": "log-analysis-gamma.deleteGroup",
          "when": "view == filters-gamma && viewItem =~ /^g-/",
          "group": "inline@7"
        },
        {
          "command": "log-analysis-gamma.deleteFilter",
          "when": "(view == filters-gamma || view == filters-gamma.minus) && viewItem =~ /^f-/",
          "group": "inline@7"
        },
        {
          "command": "log-analysis-gamma.deleteProject",
          "when": "view == filters-gamma.settings",
          "group": "inline@7"
        }
      ],
      "view/title": [
        {
          "command": "log-analysis-gamma.addGroup",
          "when": "view == filters-gamma",
          "group": "navigation@1"
        },
        {
          "command": "log-analysis-gamma.turnOnFocusMode",
          "when": "view == filters-gamma",
          "group": "navigation@2"
        },
        {
          "command": "log-analysis-gamma.saveProject",
          "when": "view == filters-gamma",
          "group": "navigation@3"
        },
        {
          "command": "log-analysis-gamma.addProject",
          "when": "view == filters-gamma.settings",
          "group": "navigation@1"
        },
        {
          "command": "log-analysis-gamma.openSettings",
          "when": "view == filters-gamma.settings",
          "group": "navigation@2"
        },
        {
          "command": "log-analysis-gamma.refreshSettings",
          "when": "view == filters-gamma.settings",
          "group": "navigation@3"
        },
        {
          "command": "log-analysis-gamma.addExFilter",
          "when": "view == filters-gamma.minus",
          "group": "navigation@1"
        },
        {
          "command": "log-analysis-gamma.deleteExGroup",
          "when": "view == filters-gamma.minus",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "log-analysis-gamma.turnOnFocusMode",
        "key": "ctrl+h",
        "mac": "cmd+h"
      }
    ],
    "views": {
      "filter_gamma_project_setting": [
        {
          "id": "filters-gamma",
          "name": "Filters+"
        },
        {
          "id": "filters-gamma.minus",
          "name": "Filters-"
        },
        {
          "id": "filters-gamma.settings",
          "name": "Projects"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "filter_gamma_project_setting",
          "title": "Log Analysis Gamma",
          "icon": "$(folder-library)"
        }
      ]
    },
    "configuration": {
      "title": "Log Analysis Gamma",
      "properties": {
        "logAnalysisGamma.userColors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
          },
          "default": [],
          "maxItems": 10,
          "description": "Recently used custom colors for filters (automatically managed)",
          "scope": "application"
        },
        "logAnalysisGamma.maxRememberedColors": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 20,
          "description": "Maximum number of custom colors to remember",
          "scope": "application"
        },
        "logAnalysisGamma.showRandomColorNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when random colors are applied",
          "scope": "application"
        },
        "logAnalysisGamma.editorSelectionStrategy": {
          "type": "string",
          "enum": ["active", "visible", "relevant", "adaptive"],
          "default": "adaptive",
          "description": "Strategy for selecting which editors to apply filters to",
          "enumDescriptions": [
            "Apply filters only to the active editor (best performance)",
            "Apply filters to all visible editors (balanced)",
            "Apply filters only to log files and relevant editors (smart)",
            "Adaptive selection based on number of open editors (intelligent)"
          ],
          "scope": "application"
        },
        "logAnalysisGamma.maxEditorsToProcess": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of editors to process simultaneously (for adaptive strategy)",
          "scope": "application"
        },
        "logAnalysisGamma.autoDetectLogFiles": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect and prioritize log files (.log, .txt, .out, .err, .trace)",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^7.1.3",
    "@types/mocha": "^8.0.0",
    "@types/node": "^14.0.27",
    "@types/vscode": "^1.49.0",
    "@typescript-eslint/eslint-plugin": "^3.8.0",
    "@typescript-eslint/parser": "^3.8.0",
    "eslint": "^7.6.0",
    "glob": "^7.1.6",
    "mocha": "^10.7.3",
    "typescript": "^4.0.2",
    "vscode-test": "^1.4.0"
  }
}
