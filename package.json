{
  "name": "log-analysis-gamma",
  "displayName": "Smart Log Highlighter",
  "description": "🚀 Smart Log Highlighter - Regex-based log file filtering, focus mode, exclusion filters, and unified project settings. Features: customizable file type detection, color-coded highlights, group-based filter management, team-shareable configurations, and an adaptive editor processing strategy for optimal performance.",
  "publisher": "hkalyane",
  "repository": {
    "type": "git",
    "url": "https://github.com/hkalyane/-log-analysis-gamma.git"
  },
  "icon": "image/icon.png",
  "version": "1.6.0",
  "engines": {
    "vscode": "^1.49.0"
  },
  "categories": [
    "Other",
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "log",
    "analysis",
    "filter",
    "highlight",
    "focus",
    "regex",
    "debugging",
    "log viewer",
    "color picker",
    "gamma"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:focus-gamma"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "log-analysis-gamma.changeBookmarkColor", "title": "Change Bookmark Color...", "icon": "$(symbol-color)", "category": "Smart Log Highlighter" },
      { "command": "log-analysis-gamma.toggleProcessing", "title": "Pause / Resume Log Processing", "icon": "$(debug-pause)", "category": "Smart Log Highlighter" },
      { "command": "log-analysis-gamma.cancelProcessing", "title": "Cancel Active Log Processing", "icon": "$(debug-stop)", "category": "Smart Log Highlighter" },
      { "command": "log-analysis-gamma.addBookmark", "title": "Bookmark Log Line...", "icon": "$(bookmark)", "category": "Smart Log Highlighter" },
      { "command": "log-analysis-gamma.openBookmark", "title": "Open Bookmark", "icon": "$(go-to-file)", "category": "Smart Log Highlighter" },
      { "command": "log-analysis-gamma.editBookmark", "title": "Edit Bookmark Note", "icon": "$(edit)", "category": "Smart Log Highlighter" },
      { "command": "log-analysis-gamma.deleteBookmark", "title": "Delete Bookmark", "icon": "$(close)", "category": "Smart Log Highlighter" },
      { "command": "log-analysis-gamma.nextBookmark", "title": "Next Bookmark", "icon": "$(arrow-down)", "category": "Smart Log Highlighter" },
      { "command": "log-analysis-gamma.previousBookmark", "title": "Previous Bookmark", "icon": "$(arrow-up)", "category": "Smart Log Highlighter" },
      { "command": "log-analysis-gamma.timeRange", "title": "Time / Cycle Range...", "icon": "$(clock)", "category": "Smart Log Highlighter" },
      { "command": "log-analysis-gamma.clearTimeRange", "title": "Clear Time / Cycle Range", "icon": "$(clear-all)", "category": "Smart Log Highlighter" },
      { "command": "log-analysis-gamma.timeSummary", "title": "Time / Cycle Summary", "icon": "$(graph)", "category": "Smart Log Highlighter" },
      {
        "command": "log-analysis-gamma.contextLines",
        "title": "Context Lines...",
        "icon": "$(list-selection)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.highlightSelection",
        "title": "Highlight This Text",
        "icon": "$(paintcan)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.excludeSelection",
        "title": "Exclude This Text",
        "icon": "$(eye-closed)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.regexSelection",
        "title": "Regex Filter from Selection...",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.exportFocused",
        "title": "Export Focused Results...",
        "icon": "$(export)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.copyFocused",
        "title": "Copy Focused Results...",
        "icon": "$(copy)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.undoFilterChange",
        "title": "Undo Filter Change",
        "icon": "$(discard)",
        "enablement": "logAnalysisGamma.canUndoFilters",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.redoFilterChange",
        "title": "Redo Filter Change",
        "icon": "$(redo)",
        "enablement": "logAnalysisGamma.canRedoFilters",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.searchFilters",
        "title": "Search Filters...",
        "icon": "$(search)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.clearFilterSearch",
        "title": "Clear Filter Search",
        "icon": "$(clear-all)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.addFilterToFile",
        "title": "Add Filter to Another File...",
        "icon": "$(new-file)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.saveAllFilters",
        "title": "Save All Changed Filters",
        "icon": "$(save-all)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.showProjectFilePaths",
        "title": "Show Project File Paths",
        "icon": "$(eye)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.hideProjectFilePaths",
        "title": "Hide Project File Paths",
        "icon": "$(eye-closed)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.openStorageFile",
        "title": "Open Settings File",
        "icon": "$(go-to-file)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.copyStoragePath",
        "title": "Copy Settings File Path",
        "icon": "$(copy)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.saveStorageFile",
        "title": "Save to This File...",
        "icon": "$(save)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.reloadStorageFile",
        "title": "Reload Settings File",
        "icon": "$(refresh)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.createStorageFile",
        "title": "Create Empty Settings File",
        "icon": "$(new-file)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.applyStorageSettings",
        "title": "Apply Settings from This File",
        "icon": "$(gear)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.addGroup",
        "title": "Add Group",
        "icon": "$(file-directory-create)"
      },
      {
        "command": "log-analysis-gamma.editGroup",
        "title": "Edit a new name for This Group",
        "icon": "$(edit)"
      },
      {
        "command": "log-analysis-gamma.deleteGroup",
        "title": "Delete This Group",
        "icon": "$(dialog-close)"
      },
      {
        "command": "log-analysis-gamma.enableHighlight",
        "title": "Enable Highlight",
        "icon": "$(paintcan)"
      },
      {
        "command": "log-analysis-gamma.disableHighlight",
        "title": "Disable Highlight",
        "icon": "$(paintcan)"
      },
      {
        "command": "log-analysis-gamma.enableVisibility",
        "title": "Enable Visbility",
        "icon": "$(eye)"
      },
      {
        "command": "log-analysis-gamma.disableVisibility",
        "title": "Disable Visbility",
        "icon": "$(eye-closed)"
      },
      {
        "command": "log-analysis-gamma.turnOnFocusMode",
        "title": "Turn on Focus Mode",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "log-analysis-gamma.deleteFilter",
        "title": "Delete This Filter",
        "icon": "$(dialog-close)"
      },
      {
        "command": "log-analysis-gamma.editFilter",
        "title": "Edit Regex for This Filter",
        "icon": "$(edit)"
      },
      {
        "command": "log-analysis-gamma.changeFilterColor",
        "title": "Change Filter Color",
        "icon": "$(symbol-color)"
      },
      {
        "command": "log-analysis-gamma.addFilter",
        "title": "Add a Filter",
        "icon": "$(plus)"
      },
      {
        "command": "log-analysis-gamma.addExFilter",
        "title": "Add a Exclusion Filter",
        "icon": "$(plus)"
      },
      {
        "command": "log-analysis-gamma.deleteExGroup",
        "title": "Delete This Exclusion Group",
        "icon": "$(trash)"
      },
      {
        "command": "log-analysis-gamma.deleteProject",
        "title": "Delete This Project",
        "icon": "$(dialog-close)"
      },
      {
        "command": "log-analysis-gamma.editProject",
        "title": "Edit a new name for This Project",
        "icon": "$(edit)"
      },
      {
        "command": "log-analysis-gamma.addProject",
        "title": "Add Project",
        "icon": "$(repo-create)"
      },
      {
        "command": "log-analysis-gamma.openSettings",
        "title": "Open Internal Filter Settings",
        "icon": "$(gear)"
      },
      {
        "command": "log-analysis-gamma.saveProject",
        "title": "Save groups to project",
        "icon": "$(save-as)"
      },
      {
        "command": "log-analysis-gamma.selectProject",
        "title": "Select project",
        "icon": "$(check)"
      },
      {
        "command": "log-analysis-gamma.openOriginalLocation",
        "title": "Open Original Location",
        "icon": "$(link-external)"
      },
      {
        "command": "log-analysis-gamma.clearColorMemory",
        "title": "Clear Recently Used Colors",
        "icon": "$(clear-all)"
      },
      {
        "command": "log-analysis-gamma.openPerformanceSettings",
        "title": "Performance Settings",
        "icon": "$(zap)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.loadUnifiedSettings",
        "title": "Load Shared Filter File",
        "icon": "$(folder-opened)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.saveUnifiedSettings",
        "title": "Save Project Settings",
        "icon": "$(save)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.refreshUnifiedSettings",
        "title": "Refresh Project Settings",
        "icon": "$(refresh)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.openUnifiedSettings",
        "title": "Open Shared Filter File",
        "icon": "$(go-to-file)",
        "category": "Smart Log Highlighter"
      },
      {
        "command": "log-analysis-gamma.unloadUnifiedSettings",
        "title": "Unload Shared Filter File",
        "icon": "$(close)",
        "category": "Smart Log Highlighter"
      }
    ],
    "menus": {
      "editor/context": [
        { "command": "log-analysis-gamma.addBookmark", "group": "logAnalysis@6" },
        { "command": "log-analysis-gamma.timeRange", "group": "logAnalysis@4" },
        { "command": "log-analysis-gamma.timeSummary", "group": "logAnalysis@5" },
        {
          "command": "log-analysis-gamma.highlightSelection",
          "when": "editorHasSelection",
          "group": "logAnalysis@1"
        },
        {
          "command": "log-analysis-gamma.excludeSelection",
          "when": "editorHasSelection",
          "group": "logAnalysis@2"
        },
        {
          "command": "log-analysis-gamma.regexSelection",
          "when": "editorHasSelection",
          "group": "logAnalysis@3"
        }
      ],
      "editor/title": [
        { "command": "log-analysis-gamma.timeRange", "when": "resourceScheme == focus-gamma", "group": "navigation@4" },
        { "command": "log-analysis-gamma.clearTimeRange", "when": "resourceScheme == focus-gamma", "group": "investigation@1" },
        { "command": "log-analysis-gamma.timeSummary", "when": "resourceScheme == focus-gamma", "group": "investigation@2" },
        {
          "command": "log-analysis-gamma.exportFocused",
          "when": "resourceScheme == focus-gamma",
          "group": "navigation@1"
        },
        {
          "command": "log-analysis-gamma.copyFocused",
          "when": "resourceScheme == focus-gamma",
          "group": "navigation@2"
        },
        {
          "command": "log-analysis-gamma.contextLines",
          "when": "resourceScheme == focus-gamma",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        { "command": "log-analysis-gamma.changeBookmarkColor", "when": "view == filters-gamma.bookmarks", "group": "inline@2" },
        { "command": "log-analysis-gamma.editBookmark", "when": "view == filters-gamma.bookmarks", "group": "inline@1" },
        { "command": "log-analysis-gamma.deleteBookmark", "when": "view == filters-gamma.bookmarks", "group": "inline@2" },
        {
          "command": "log-analysis-gamma.openStorageFile",
          "when": "view == filters-gamma.settings && viewItem =~ /^source-/",
          "group": "file@1"
        },
        {
          "command": "log-analysis-gamma.copyStoragePath",
          "when": "view == filters-gamma.settings && viewItem =~ /^source-/",
          "group": "file@2"
        },
        {
          "command": "log-analysis-gamma.unloadUnifiedSettings",
          "when": "view == filters-gamma.settings && viewItem =~ /^source-external-/",
          "group": "file@3"
        },
        {
          "command": "log-analysis-gamma.addFilterToFile",
          "when": "view == filters-gamma && viewItem =~ /^g-/",
          "group": "file@1"
        },
        {
          "command": "log-analysis-gamma.openStorageFile",
          "when": "view == filters-gamma.files",
          "group": "inline@1"
        },
        {
          "command": "log-analysis-gamma.saveStorageFile",
          "when": "view == filters-gamma.files && viewItem =~ /-loaded$/",
          "group": "inline@2"
        },
        {
          "command": "log-analysis-gamma.unloadUnifiedSettings",
          "when": "view == filters-gamma.files && viewItem =~ /^external-/",
          "group": "inline@3"
        },
        {
          "command": "log-analysis-gamma.copyStoragePath",
          "when": "view == filters-gamma.files",
          "group": "file@1"
        },
        {
          "command": "log-analysis-gamma.reloadStorageFile",
          "when": "view == filters-gamma.files",
          "group": "file@2"
        },
        {
          "command": "log-analysis-gamma.applyStorageSettings",
          "when": "view == filters-gamma.files && viewItem =~ /-loaded$/",
          "group": "file@3"
        },
        {
          "command": "log-analysis-gamma.addFilter",
          "when": "view == filters-gamma && viewItem =~ /^g-/",
          "group": "inline@1"
        },
        {
          "command": "log-analysis-gamma.editGroup",
          "when": "view == filters-gamma && viewItem =~ /^g-/",
          "group": "inline@2"
        },
        {
          "command": "log-analysis-gamma.editFilter",
          "when": "(view == filters-gamma || view == filters-gamma.minus) && viewItem =~ /^f-/",
          "group": "inline@2"
        },
        {
          "command": "log-analysis-gamma.changeFilterColor",
          "when": "view == filters-gamma && viewItem =~ /^f-/",
          "group": "inline@3"
        },
        {
          "command": "log-analysis-gamma.editProject",
          "when": "view == filters-gamma.settings && viewItem == project",
          "group": "inline@3"
        },
        {
          "command": "log-analysis-gamma.disableHighlight",
          "when": "view == filters-gamma && viewItem =~ /-lit/",
          "group": "inline@4"
        },
        {
          "command": "log-analysis-gamma.enableHighlight",
          "when": "view == filters-gamma && viewItem =~ /-unlit/",
          "group": "inline@5"
        },
        {
          "command": "log-analysis-gamma.disableVisibility",
          "when": "(view == filters-gamma || view == filters-gamma.minus) && viewItem =~ /-visible/",
          "group": "inline@6"
        },
        {
          "command": "log-analysis-gamma.enableVisibility",
          "when": "(view == filters-gamma || view == filters-gamma.minus) && viewItem =~ /-invisible/",
          "group": "inline@6"
        },
        {
          "command": "log-analysis-gamma.deleteGroup",
          "when": "view == filters-gamma && viewItem =~ /^g-/",
          "group": "inline@7"
        },
        {
          "command": "log-analysis-gamma.deleteFilter",
          "when": "(view == filters-gamma || view == filters-gamma.minus) && viewItem =~ /^f-/",
          "group": "inline@7"
        },
        {
          "command": "log-analysis-gamma.deleteProject",
          "when": "view == filters-gamma.settings && viewItem == project",
          "group": "inline@7"
        }
      ],
      "view/title": [
        { "command": "log-analysis-gamma.toggleProcessing", "when": "view == filters-gamma", "group": "processing@1" },
        { "command": "log-analysis-gamma.cancelProcessing", "when": "view == filters-gamma", "group": "processing@2" },
        { "command": "log-analysis-gamma.addBookmark", "when": "view == filters-gamma.bookmarks", "group": "navigation@1" },
        { "command": "log-analysis-gamma.previousBookmark", "when": "view == filters-gamma.bookmarks", "group": "navigation@2" },
        { "command": "log-analysis-gamma.nextBookmark", "when": "view == filters-gamma.bookmarks", "group": "navigation@3" },
        {
          "command": "log-analysis-gamma.undoFilterChange",
          "when": "view == filters-gamma || view == filters-gamma.minus",
          "group": "navigation@5"
        },
        {
          "command": "log-analysis-gamma.redoFilterChange",
          "when": "view == filters-gamma || view == filters-gamma.minus",
          "group": "navigation@6"
        },
        {
          "command": "log-analysis-gamma.searchFilters",
          "when": "view == filters-gamma || view == filters-gamma.minus",
          "group": "navigation@3"
        },
        {
          "command": "log-analysis-gamma.clearFilterSearch",
          "when": "(view == filters-gamma || view == filters-gamma.minus) && logAnalysisGamma.filterSearchActive",
          "group": "navigation@4"
        },
        {
          "command": "log-analysis-gamma.saveAllFilters",
          "when": "view == filters-gamma.files",
          "group": "navigation@4"
        },
        {
          "command": "log-analysis-gamma.showProjectFilePaths",
          "when": "view == filters-gamma.settings && !config.logAnalysisGamma.showProjectFilePaths",
          "group": "navigation@9"
        },
        {
          "command": "log-analysis-gamma.hideProjectFilePaths",
          "when": "view == filters-gamma.settings && config.logAnalysisGamma.showProjectFilePaths",
          "group": "navigation@9"
        },
        {
          "command": "log-analysis-gamma.loadUnifiedSettings",
          "when": "view == filters-gamma.files",
          "group": "navigation@1"
        },
        {
          "command": "log-analysis-gamma.createStorageFile",
          "when": "view == filters-gamma.files",
          "group": "navigation@2"
        },
        {
          "command": "log-analysis-gamma.refreshUnifiedSettings",
          "when": "view == filters-gamma.files",
          "group": "navigation@3"
        },
        {
          "command": "log-analysis-gamma.addGroup",
          "when": "view == filters-gamma",
          "group": "navigation@1"
        },
        {
          "command": "log-analysis-gamma.turnOnFocusMode",
          "when": "view == filters-gamma",
          "group": "navigation@2"
        },
        {
          "command": "log-analysis-gamma.addProject",
          "when": "view == filters-gamma.settings",
          "group": "navigation@1"
        },
        {
          "command": "log-analysis-gamma.openSettings",
          "when": "view == filters-gamma.settings",
          "group": "navigation@2"
        },
        {
          "command": "log-analysis-gamma.loadUnifiedSettings",
          "when": "view == filters-gamma.settings",
          "group": "navigation@3"
        },
        {
          "command": "log-analysis-gamma.saveUnifiedSettings",
          "when": "view == filters-gamma.settings",
          "group": "navigation@4"
        },
        {
          "command": "log-analysis-gamma.refreshUnifiedSettings",
          "when": "view == filters-gamma.settings",
          "group": "navigation@5"
        },
        {
          "command": "log-analysis-gamma.openUnifiedSettings",
          "when": "view == filters-gamma.settings",
          "group": "navigation@6"
        },
        {
          "command": "log-analysis-gamma.unloadUnifiedSettings",
          "when": "view == filters-gamma.settings",
          "group": "navigation@7"
        },
        {
          "command": "log-analysis-gamma.openPerformanceSettings",
          "when": "view == filters-gamma.settings",
          "group": "navigation@8"
        },
        {
          "command": "log-analysis-gamma.addExFilter",
          "when": "view == filters-gamma.minus",
          "group": "navigation@1"
        },
        {
          "command": "log-analysis-gamma.deleteExGroup",
          "when": "view == filters-gamma.minus",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "log-analysis-gamma.turnOnFocusMode",
        "key": "ctrl+h",
        "mac": "cmd+h"
      }
    ],
    "views": {
      "filter_gamma_project_setting": [
        { "id": "filters-gamma.bookmarks", "name": "Bookmarks" },
        {
          "id": "filters-gamma.files",
          "name": "Storage Files"
        },
        {
          "id": "filters-gamma.settings",
          "name": "Projects"
        },
        {
          "id": "filters-gamma",
          "name": "Filters+"
        },
        {
          "id": "filters-gamma.minus",
          "name": "EXCLUDE_FILTER"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "filter_gamma_project_setting",
          "title": "Smart Log Highlighter",
          "icon": "$(folder-library)"
        }
      ]
    },
    "configuration": {
      "title": "Smart Log Highlighter",
      "properties": {
        "logAnalysisGamma.timeProfiles": {
          "type": "object",
          "default": {},
          "description": "Time or cycle profiles keyed by original document URI. Configure through Time / Cycle Range."
        },
        "logAnalysisGamma.processingTimeoutMs": {
          "type": "integer",
          "default": 10000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "Maximum worker processing time per log operation before cancellation."
        },
        "logAnalysisGamma.contextBefore": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 100,
          "description": "Lines before each Focus Mode match. Exclusions still apply."
        },
        "logAnalysisGamma.contextAfter": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 100,
          "description": "Lines after each Focus Mode match. Exclusions still apply."
        },
        "logAnalysisGamma.showProjectFilePaths": {
          "type": "boolean",
          "default": false,
          "description": "Show storage file paths beside project names in the Projects view. Full paths remain available in tooltips when hidden.",
          "scope": "application"
        },
        "logAnalysisGamma.userColors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
          },
          "default": [],
          "maxItems": 10,
          "description": "Recently used custom colors for filters (automatically managed)",
          "scope": "application"
        },
        "logAnalysisGamma.maxRememberedColors": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 20,
          "description": "Maximum number of custom colors to remember",
          "scope": "application"
        },
        "logAnalysisGamma.showRandomColorNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when random colors are applied",
          "scope": "application"
        },
        "logAnalysisGamma.editorSelectionStrategy": {
          "type": "string",
          "enum": [
            "active",
            "visible",
            "relevant",
            "adaptive"
          ],
          "default": "adaptive",
          "description": "Strategy for selecting which editors to apply filters to",
          "enumDescriptions": [
            "Apply filters only to the active editor (best performance)",
            "Apply filters to all visible editors (balanced)",
            "Apply filters only to log files and relevant editors (smart)",
            "Adaptive selection based on number of open editors (intelligent)"
          ],
          "scope": "application"
        },
        "logAnalysisGamma.maxEditorsToProcess": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of editors to process simultaneously (for adaptive strategy)",
          "scope": "application"
        },
        "logAnalysisGamma.autoDetectLogFiles": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect and prioritize log files",
          "scope": "application"
        },
        "logAnalysisGamma.relevantFileExtensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.[a-zA-Z0-9]+$"
          },
          "default": [
            ".log",
            ".txt",
            ".out",
            ".err",
            ".trace"
          ],
          "description": "File extensions to consider as 'relevant' for the relevant editor selection strategy",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js"
  },
